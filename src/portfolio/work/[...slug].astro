---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseAside from "../../components/CaseAside.astro";
import { link, asset } from "../../config";

export async function getStaticPaths() {
  const projects = await getCollection("work", ({ data }) => !data.draft);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

// section nav from the ## headings
const toc = headings.filter((h) => h.depth === 2);

// next project (wrap around) for the footer
const all = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];
---

<BaseLayout title={d.title} description={d.summary} image={asset(d.cover)}>
  <article class="case">
    <!-- Nav -->
    <div class="wrap case-topnav load-in">
      <a class="back" href={link("#work")}>← Work</a>
    </div>

    <!-- TL;DR band — the 20-second read, as a subtle bento grid -->
    <header class="wrap case-head load-in">
      <div class="bento">
        <div class="bento-cell bento-main">
          <p class="eyebrow">{d.company ?? "Case study"}{d.ai ? " · AI" : ""}</p>
          <h1>{d.title}</h1>
          <p class="case-problem">{d.problem ?? d.summary}</p>
        </div>
        <div class="bento-facts">
          <div class="bento-cell fact">
            <span class="fact-k">Role</span><span class="fact-v">{d.role}</span>
          </div>
          {d.team && (
            <div class="bento-cell fact">
              <span class="fact-k">Team</span><span class="fact-v">{d.team}</span>
            </div>
          )}
          <div class="bento-cell fact">
            <span class="fact-k">Timeline</span><span class="fact-v">{d.timeline}</span>
          </div>
          {d.metric && (
            <div class="bento-cell fact fact--metric">
              <span class="fact-k">{d.metric.label}</span><span class="fact-v">{d.metric.value}</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Cover -->
    <div class="wrap">
      {
        d.cover ? (
          <img class="case-cover load-in" src={asset(d.cover)} alt={d.coverAlt ?? d.title} />
        ) : (
          <div class="case-cover cover-placeholder load-in">{d.title}</div>
        )
      }
    </div>

    <!-- Body: sticky TOC + editorial prose -->
    <div class="wrap case-layout load-in">
      {
        toc.length > 0 && (
          <nav class="case-toc" aria-label="Sections">
            <div class="case-density" role="group" aria-label="Reading density">
              <button class="cd-btn" type="button" data-density="detailed" aria-pressed="true">Detailed</button>
              <button class="cd-btn" type="button" data-density="tldr" aria-pressed="false">TL;DR</button>
            </div>
            <p class="case-toc-label">Contents</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="case-prose">
        <Content components={{ blockquote: CaseAside }} />
      </div>
    </div>

    <!-- Next -->
    <div class="wrap case-next">
      <span class="eyebrow">Next</span>
      <a class="case-next-link" href={link(`work/${next.id}`)}>
        <span class="case-next-title">{next.data.title}</span>
        <span class="case-next-arrow">→</span>
      </a>
    </div>
  </article>
</BaseLayout>

<script>
  (function () {
    var RM = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.documentElement.classList.add("has-js");

    // scroll-reveal
    var revealEls = Array.prototype.slice.call(
      document.querySelectorAll(".case-prose h2, .case-prose h3, .case-prose img, .case-aside"),
    );
    revealEls.forEach(function (el) { el.classList.add("reveal"); });
    if (RM || !("IntersectionObserver" in window)) {
      revealEls.forEach(function (el) { el.classList.add("in"); });
    } else {
      var ro = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); ro.unobserve(e.target); }
          });
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      revealEls.forEach(function (el) { ro.observe(el); });
    }

    // scrollspy for the sticky TOC
    var links = Array.prototype.slice.call(document.querySelectorAll(".case-toc a"));
    if (links.length && "IntersectionObserver" in window) {
      var byId = {};
      links.forEach(function (a) { byId[a.getAttribute("href").slice(1)] = a; });
      var heads = Array.prototype.slice.call(document.querySelectorAll(".case-prose h2[id]"));
      var spy = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              links.forEach(function (a) { a.removeAttribute("aria-current"); });
              var a = byId[e.target.id];
              if (a) a.setAttribute("aria-current", "true");
            }
          });
        },
        { rootMargin: "-45% 0px -50% 0px" },
      );
      heads.forEach(function (h) { spy.observe(h); });
    }

    // Detailed / TL;DR density toggle.
    // The first flow element after each heading is the "lead" (always shown);
    // deeper paragraphs/lists collapse in TL;DR. Callouts + metric always stay.
    var article = document.querySelector(".case");
    var kids = Array.prototype.slice.call(document.querySelectorAll(".case-prose > *"));
    var afterHeading = false;
    kids.forEach(function (el) {
      var tag = el.tagName.toLowerCase();
      if (tag === "h2" || tag === "h3") { afterHeading = true; return; }
      if (el.classList.contains("case-aside")) return; // agent callouts stay
      if (["p", "ul", "ol", "figure", "img", "pre", "blockquote"].indexOf(tag) !== -1) {
        el.setAttribute("data-density", afterHeading ? "lead" : "detail");
        afterHeading = false;
      }
    });
    var dbtns = Array.prototype.slice.call(document.querySelectorAll(".cd-btn"));
    function setDensity(d) {
      article.classList.toggle("tldr", d === "tldr");
      dbtns.forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-density") === d));
      });
      try { localStorage.setItem("caseDensity", d); } catch (e) {}
    }
    dbtns.forEach(function (b) {
      b.addEventListener("click", function () { setDensity(b.getAttribute("data-density")); });
    });
    var saved = null;
    try { saved = localStorage.getItem("caseDensity"); } catch (e) {}
    if (saved === "tldr") setDensity("tldr");
  })();
</script>

<style>
  .case { padding-bottom: var(--space-2xl); }

  /* subtle staggered entrance on page load (pure CSS: no-JS safe; disabled under reduced-motion) */
  @keyframes caseIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .load-in { animation: caseIn 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .case-topnav.load-in { animation-delay: 0.02s; }
  .case-head.load-in { animation-delay: 0.09s; }
  .case-cover.load-in { animation-delay: 0.17s; }
  .case-layout.load-in { animation-delay: 0.25s; }
  .case-topnav {
    display: flex; justify-content: space-between;
    padding-block: var(--space-m);
  }
  /* subtle text back link — no container/shadow */
  .back {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-muted);
    padding: 4px 2px;
    transition: color 0.2s ease;
  }
  .back:hover { color: var(--accent); }

  /* TL;DR band — bento grid, full width of the cover below it */
  .case-head { padding-block: var(--space-l) var(--space-m); }
  .bento { display: grid; grid-template-columns: 1.6fr 1fr; gap: 8px; }
  .bento-cell {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .bento-main {
    padding: 32px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .bento-main h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-block: 8px 16px;
    max-width: 18ch;
  }
  .case-problem { font-size: var(--step-1); color: var(--text-muted); max-width: 44ch; }
  .bento-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .fact { padding: 20px; display: flex; flex-direction: column; gap: 8px; justify-content: center; }
  .fact-k {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-muted);
  }
  .fact-v { font-weight: 500; font-size: var(--step-0); }
  .fact--metric { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); }
  .fact--metric .fact-v {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .case-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-block: var(--space-m) var(--space-xl);
  }

  /* Body layout: sticky TOC + prose */
  .case-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .case-toc {
    position: sticky;
    top: 96px;
    align-self: start;
  }
  .case-density {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    margin-bottom: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .cd-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .cd-btn:hover { color: var(--text); }
  .cd-btn[aria-pressed="true"] {
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .case-toc-label {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--faint); margin-bottom: var(--space-s);
  }
  .case-toc ul { list-style: none; padding: 0; display: grid; gap: 10px; }
  .case-toc a {
    font-size: var(--step--1);
    color: var(--text-muted);
    border-left: 2px solid var(--line);
    padding-left: 12px;
    transition: color 0.2s ease, border-color 0.2s ease;
    display: block;
  }
  .case-toc a:hover { color: var(--text); }
  .case-toc a[aria-current="true"] { color: var(--text); border-left-color: var(--accent); }

  /* Editorial prose — comfortable reading size + measure */
  .case-prose { max-width: 64ch; font-size: var(--step-0); line-height: 1.75; }
  .case-prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-s);
    scroll-margin-top: 96px;
  }
  /* TL;DR mode hides the deeper paragraphs; leads, callouts + metric stay */
  .case.tldr .case-prose :global([data-density="detail"]) { display: none; }
  .case-prose :global(h2:first-of-type) { margin-top: 0; }
  .case-prose :global(h3) {
    font-size: var(--step-1);
    margin-top: var(--space-l);
    margin-bottom: var(--space-xs);
  }
  .case-prose :global(p) { margin-bottom: var(--space-m); color: var(--text); }
  .case-prose :global(ul), .case-prose :global(ol) { margin: 0 0 var(--space-m); padding-left: 24px; color: var(--text); }
  .case-prose :global(li) { margin-bottom: 8px; }
  .case-prose :global(li::marker) { color: var(--accent); }
  .case-prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .case-prose :global(img) { width: 100%; border-radius: var(--radius); margin-block: var(--space-m); border: 1px solid var(--line); }
  .case-prose :global(hr) { border: none; border-top: 1px solid var(--line); margin-block: var(--space-xl); }
  .case-prose :global(code) { background: var(--surface-2); padding: 0.1em 0.4em; border-radius: 5px; }

  /* Next */
  .case-next {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .case-next-link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-m);
    margin-top: var(--space-xs);
    padding: var(--space-m) 0;
  }
  .case-next-title { font-family: var(--font-display); font-size: var(--step-3); letter-spacing: -0.02em; }
  .case-next-arrow { font-size: var(--step-2); color: var(--accent); transition: transform 0.2s ease; }
  .case-next-link:hover .case-next-arrow { transform: translateX(8px); }
  .case-next-link:hover .case-next-title { color: var(--accent); }

  /* reveal (only hides when JS is present, so no-JS keeps everything visible) */
  .reveal { transition: opacity 0.6s ease, transform 0.6s ease; }
  :global(.has-js) .reveal { opacity: 0; transform: translateY(14px); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.has-js) .reveal { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .bento { grid-template-columns: 1fr; }
    .bento-main { padding: 24px; }
    /* minmax(0,1fr) so the horizontal section-nav scrolls instead of stretching the track */
    .case-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-l); }
    .case-toc {
      position: static;
      min-width: 0;
      border-bottom: 1px solid var(--line);
      padding-bottom: var(--space-m);
    }
    .case-toc ul { grid-auto-flow: column; grid-auto-columns: max-content; overflow-x: auto; max-width: 100%; }
    .case-toc a { border-left: none; padding-left: 0; }
    .cd-btn { padding: 8px 12px; }
  }
  @media (max-width: 480px) {
    .bento-facts { grid-template-columns: 1fr; }
  }
</style>
