---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="wrap contact">
    <p class="status"><span class="dot" aria-hidden="true"></span>{site.location} · Available for work</p>
    <h1>Let's build something people trust.</h1>
    <p class="lede muted">
      Have a role, a project, or just want to compare notes on designing AI products? The
      fastest way to reach me is email.
    </p>

    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>

    <ul class="socials">
      {
        site.socials.map((s) => (
          <li>
            <a class="btn btn--ghost" href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>

    <p class="agent-note">
      <span class="spark" aria-hidden="true">✦</span>
      the canvas agent will make sure it reaches me.
    </p>
  </section>
</BaseLayout>

<style>
  .contact { max-width: 780px; padding-block: var(--space-xl) var(--space-2xl); }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-m);
  }
  .status .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--good) 20%, transparent);
  }
  .contact h1 {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .lede {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 46ch;
    margin-top: var(--space-m);
  }
  .email {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 2.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
    display: inline-block;
    margin-block: var(--space-xl) var(--space-l);
    text-underline-offset: 6px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .email:hover { text-decoration: underline; color: var(--accent-2); }
  .socials {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .agent-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
  }
  .agent-note .spark { color: var(--accent); }
</style>
