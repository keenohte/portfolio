---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CanvasHero from "./CanvasHero.astro";
import WorkCard from "../components/WorkCard.astro";
import { link } from "../config";

const projects = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout fullBleed>
  <script is:inline>
    /* Arriving via a #work link (e.g. the case-study back button) should land directly
       at the work section — not start at the top and animate a scroll down through the
       hero. Same-page nav clicks keep the smooth scroll (this only runs on load). */
    if (location.hash === "#work") {
      var de = document.documentElement;
      de.style.scrollBehavior = "auto";
      addEventListener("load", function () {
        var el = document.getElementById("work");
        if (el) el.scrollIntoView();
        setTimeout(function () { de.style.scrollBehavior = ""; }, 120);
      });
    }
  </script>

  <!-- page-level dot grid: spans the hero and fades out inside the work section -->
  <div class="page-grid" aria-hidden="true"></div>

  <!-- Interactive canvas hero (falls back to a static hero on mobile / reduced-motion) -->
  <CanvasHero />

  <!-- Work — the canonical list of all projects (also the mobile/no-JS/reduced-motion view) -->
  <section class="wrap section" id="work">
    <div class="section-head">
      <h2 class="eyebrow">All work</h2>
      <span class="muted count">{projects.length} projects</span>
    </div>
    <div class="grid">
      {
        projects.map((p) => (
          <WorkCard
            href={link(`work/${p.id}`)}
            title={p.data.title}
            summary={p.data.summary}
            company={p.data.company}
            timeline={p.data.timeline}
            tags={p.data.tags}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-l);
  }
  .page-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 140vh;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--dot) 1.1px, transparent 1.1px);
    background-size: 24px 24px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 70%, transparent 100%);
  }
  /* keep real content above the dot-grid layer */
  section { position: relative; z-index: 1; }

  /* clicking Work / Scroll lands the section flush at the top (no canvas peeking);
     the section's own top padding keeps the heading clear of the floating nav */
  #work { scroll-margin-top: 0; }
  .count { font-family: var(--font-mono); font-size: var(--step--1); }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
