---
import { site, nav, link } from "../config";
import { Image } from "astro:assets";
import avatarDefault from "../assets/avatar-default.png";
import avatarHover from "../assets/avatar-hover.png";
interface Props { landing?: boolean }
const { landing = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes("#") && path.startsWith(href);
---

<nav class="floatnav" aria-label="Primary">
  <a class="fn-home" href={link()} aria-label={`${site.name} — home`}>
    <span class="fn-avatar" aria-hidden="true">
      <Image src={avatarDefault} height={120} format="webp" quality={90} alt="" class="avatar-default" loading="eager" />
      <Image src={avatarHover} height={120} format="webp" quality={90} alt="" class="avatar-hover" loading="eager" />
    </span>
  </a>
  <div class="fn-pill">
    {landing && <span class="fn-link">Portfolio in progress</span>}
    {
      !landing && nav.map((item) => (
        <a
          class="fn-link"
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
  <button class="fn-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode">
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</nav>

<script>
  var __tbtn = document.getElementById("themeToggle");
  if (__tbtn) {
    __tbtn.addEventListener("click", function () {
      var isDark = document.documentElement.getAttribute("data-theme") === "dark";
      if (isDark) {
        document.documentElement.removeAttribute("data-theme");
        try { localStorage.setItem("theme", "light"); } catch (e) {}
      } else {
        document.documentElement.setAttribute("data-theme", "dark");
        try { localStorage.setItem("theme", "dark"); } catch (e) {}
      }
    });
  }

  // Mark the "Work" nav link as current while the Work section is in view (scrollspy).
  (function () {
    var workLink = document.querySelector('.fn-link[href$="#work"]');
    var workSection = document.getElementById("work");
    if (!workLink || !workSection || !("IntersectionObserver" in window)) return;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) workLink.setAttribute("aria-current", "page");
          else workLink.removeAttribute("aria-current");
        });
      },
      { rootMargin: "-45% 0px -45% 0px" }, // fires when the section crosses the viewport middle
    );
    io.observe(workSection);
  })();
</script>

<style>
  .floatnav {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 24px);
  }

  .fn-home {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 62%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--hairline);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.6);
    transition: transform 0.15s ease, border-color 0.2s ease;
  }
  .fn-home:hover { transform: translateY(-1px); border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .fn-avatar {
    width: 34px; height: 34px; position:relative;
  }
  .fn-avatar img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; transition:opacity .15s ease; }
  .avatar-hover { opacity:0; }
  .fn-home:hover .avatar-default, .fn-home:focus-visible .avatar-default { opacity:0; }
  .fn-home:hover .avatar-hover, .fn-home:focus-visible .avatar-hover { opacity:1; }
  @media(prefers-reduced-motion:reduce) { .fn-avatar img { transition:none; } }

  .fn-toggle {
    flex: none;
    width: 48px; height: 48px;
    display: grid; place-items: center;
    border-radius: 999px;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 62%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--hairline);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.15s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .fn-toggle:hover { transform: translateY(-1px); color: var(--text); border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .fn-toggle svg { display: block; }
  /* light (default) shows the moon (tap = go dark); dark shows the sun (tap = go light) */
  .fn-toggle .icon-sun { display: none; }
  :global(html[data-theme="dark"]) .fn-toggle .icon-sun { display: block; }
  :global(html[data-theme="dark"]) .fn-toggle .icon-moon { display: none; }

  .fn-pill {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 62%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid var(--hairline);
    /* lighter in light mode; the dark theme restores a deeper shadow below */
    box-shadow: 0 6px 20px -12px rgba(0, 0, 0, 0.22);
  }
  :global(html[data-theme="dark"]) .fn-pill { box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.6); }
  .fn-link {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 0.18s ease, background 0.18s ease;
  }
  .fn-link:hover { color: var(--text); background: color-mix(in srgb, var(--text) 8%, transparent); }
  .fn-link[aria-current="page"] {
    color: var(--text);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 460px) {
    .fn-link { padding: 8px 12px; }
    .fn-home { width: 44px; height: 44px; }
  }
</style>
